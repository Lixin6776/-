# 复制成 .env 后按需修改（.env 不会进仓库）
# 用哪个账户、盯哪个直播间 —— 这两个必须填

# 巨量千川账户 ID（aavid）
QCA_AAVID=

# 只读取这个直播间的数据（名字要和千川里显示的一致，用于挑对的大屏页）
QCA_LIVE_BOARD_ROOM_NAME=

# ---- 以下都有默认值，一般不用改 ----

# 调试浏览器地址
# QCA_CDP_ENDPOINT=http://127.0.0.1:9222

# 盯盘间隔（秒）
# QCA_MONITOR_INTERVAL_SECONDS=300

# 只读模式
# QCA_READ_ONLY_MODE=true

# 大模型（也可以启动后在工具「大模型」窗口里填）
# QCA_LLM_BASE_URL=https://api.deepseek.com
# QCA_LLM_API_KEY=
# QCA_LLM_MODEL=deepseek-chat

# 跑测试时关掉后台任务（盯盘循环、每日汇报、开机补跑）
# QCA_ENABLE_BACKGROUND_JOBS=false
